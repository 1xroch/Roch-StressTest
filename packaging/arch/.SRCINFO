pkgbase = roch-stresstest-bin
	pkgdesc = Every stress test in one window: Prime95, y-cruncher, memtest_vulkan and OCCT, timed and watched for errors
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/1xroch/Roch-StressTest
	install = roch-stresstest.install
	arch = x86_64
	license = GPL-3.0-or-later
	license = LicenseRef-Prime95
	license = LicenseRef-y-cruncher
	license = Zlib
	depends = glibc
	depends = libgcc
	depends = hicolor-icon-theme
	depends = gmp
	optdepends = libglvnd: the window
	optdepends = libxkbcommon: the window
	optdepends = wayland: the window on Wayland
	optdepends = libx11: the window on X11
	optdepends = libxcursor: the window on X11
	optdepends = libxi: the window on X11
	optdepends = libxkbcommon-x11: the window on X11
	optdepends = fontconfig: the system fonts
	optdepends = xdg-utils: opening links from the window
	optdepends = vulkan-icd-loader: memtest_vulkan, the graphics memory test
	optdepends = foot: a terminal for the console tools (alacritty, kitty, ghostty, konsole, gnome-terminal or xterm work too)
